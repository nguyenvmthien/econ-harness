# Text is stored with LF and checked out with LF, Windows included.
# PowerShell and batch files need CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.docx binary
*.xlsx binary
*.xls binary
*.rds binary
*.RData binary
*.pdf binary
*.png binary
*.jpg binary

# Generated from harness/ by harness/scripts/sync-agents.mjs; collapsed in GitHub diffs.
.claude/** linguist-generated
template/.claude/** linguist-generated
harness/mcp/research-discovery/package-lock.json linguist-generated
